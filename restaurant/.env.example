EXPO_PUBLIC_API_URL=http://10.12.124.62:4000
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Google Sign-In — web client ID must be in user-service GOOGLE_CLIENT_IDS.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Delivery partner Join Us / register URL (restaurant invite links).
# Prefer the DeliverHub partner app or hosted register page — not localhost for sharing.
# EXPO_PUBLIC_PARTNER_REGISTER_URL=http://localhost:8081/register

# Firebase Web app (Phone Auth for partner signup). Same project as server FIREBASE_*.
# Console → Project settings → Your apps → Web app. Public keys only (not the Admin private key).
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tokajofoods.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=tokajofoods
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=tokajofoods.appspot.com
