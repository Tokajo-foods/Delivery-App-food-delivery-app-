{
  "expo": {
    "name": "TOKAJO FOODS",
    "slug": "restaurant-portal",
    "version": "1.0.0",
    "scheme": "tokajofoods",
    "orientation": "portrait",
    "icon": "./assets/tokajo-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-brand.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#F7EFE4"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TOKAJO FOODS to access your location so we can assign nearby deliveries and share your live position while you are online.",
          "locationAlwaysAndWhenInUsePermission": "Allow TOKAJO FOODS to share your live location during an active delivery, including when the app is in the background. Sharing stops when the trip ends.",
          "locationAlwaysPermission": "Allow TOKAJO FOODS to share your live location during an active delivery, including when the app is in the background. Sharing stops when the trip ends.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/tokajo-logo.png",
          "color": "#7A0E22",
          "defaultChannel": "tokajo-delivery-alerts"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "usesCleartextTraffic": true
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ],
      ["@livekit/react-native-expo-plugin", { "android": { "audioType": "communication" } }],
      "@config-plugins/react-native-webrtc"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tokajofoods.restaurant",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow TOKAJO FOODS to use the microphone for in-app calls on an order. Your mobile number stays hidden.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.tokajofoods.restaurant",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F5C518",
        "foregroundImage": "./assets/tokajo-logo.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/tokajo-logo.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "909628eb-e4ce-41be-a284-c1fbf7876c39"
      },
      "apiUrl": "http://10.12.129.12:4000",
      "googleMapsApiKey": "",
      "googleWebClientId": "",
      "googleIosClientId": "",
      "googleAndroidClientId": ""
    },
    "owner": "anshul071727"
  }
}
