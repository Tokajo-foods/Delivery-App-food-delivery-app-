# EAS uploads with these rules instead of .gitignore, so the git-ignored .env (EXPO_PUBLIC_* client
# config) and google-services.json still reach cloud builds. eas.json profile env wins over .env.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# release artifacts
*.apk
*.aab

# generated native folders
/ios
/android
